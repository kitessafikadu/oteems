// This is your Prisma schema file.
// Learn more about it in the Prisma documentation:
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  HR_USER
  DEPARTMENT_MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum LeaveRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveRequestAction {
  CREATED
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

// ============================================================
// USER
// ============================================================

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  // Link account to employee
  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  // Leave requests reviewed by this user
  reviewedLeaveRequests LeaveRequest[] @relation("LeaveRequestReviewer")

  // Leave request history actions performed by this user
  leaveRequestHistory LeaveRequestHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

// ============================================================
// DEPARTMENT
// ============================================================

model Department {
  id        String  @id @default(uuid())
  name      String  @unique

  // Employee who manages this department
  managerId String?   @unique
  manager   Employee? @relation("DepartmentManager", fields: [managerId], references: [id])

  // Employees belonging to this department
  employees Employee[] @relation("DepartmentEmployees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managerId])
}

// ============================================================
// EMPLOYEE ID SEQUENCE
// ============================================================

model EmployeeIdSequence {
  role       UserRole @id
  nextNumber Int      @default(1001)
  updatedAt  DateTime @updatedAt
}

// ============================================================
// EMPLOYEE
// ============================================================

model Employee {
  id         String           @id @default(uuid())
  employeeId String           @unique

  fullName String
  phone    String
  email    String           @unique
  position String
  hireDate DateTime

  status EmploymentStatus @default(ACTIVE)

  // Department
  departmentId String
  department   Department @relation("DepartmentEmployees", fields: [departmentId], references: [id])

  // Login account
  user User?

  // Employee leave requests
  leaveRequests LeaveRequest[]

  // Department managed by this employee
  managedDepartment Department? @relation("DepartmentManager")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([fullName])
}

// ============================================================
// LEAVE REQUEST
// ============================================================

model LeaveRequest {
  id            String @id @default(uuid())
  requestNumber String @unique

  // Employee requesting leave
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  // Leave information
  leaveType LeaveType

  startDate DateTime
  endDate   DateTime
  leaveDays Int

  reason String

  // Current workflow status
  status LeaveRequestStatus @default(DRAFT)

  // Latest review information
  reviewedAt   DateTime?
  reviewedById String?
  reviewer     User? @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id])

  rejectionReason String?

  // Complete request history
  history LeaveRequestHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([leaveType])
  @@index([startDate])
  @@index([reviewedById])
}

// ============================================================
// LEAVE REQUEST HISTORY
// ============================================================

model LeaveRequestHistory {
  id String @id @default(uuid())

  // Request associated with this history record
  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  // What happened
  action LeaveRequestAction

  // User who performed the action
  performedById String
  performedBy   User @relation(fields: [performedById], references: [id])

  // Optional comment/reason
  comment String?

  createdAt DateTime @default(now())

  @@index([leaveRequestId])
  @@index([performedById])
  @@index([action])
}